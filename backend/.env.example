# Groq LLM (already pre-filled)
GROQ_API_KEY=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

# Pinecone Vector Database
# Get your key from: https://www.pinecone.io -> Dashboard -> API Keys
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone index name (create in dashboard: Dims=384, Metric=cosine, AWS us-east-1)
PINECONE_INDEX_NAME=documind

# LLM / Embedding Settings (optional, defaults shown)
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Settings (optional)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Upload Limits (optional)
MAX_UPLOAD_SIZE_MB=50

# CORS - comma separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug Mode
DEBUG=false
